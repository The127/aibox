# Merged on top of microvm.config and kernel.config. Hyper-V offers none of
# the virtio devices of QEMU, so this kernel needs its own drivers for the
# same things: disks, vsock, the shares and the console.

# VMBus is found through ACPI, which microvm.config leaves out. ACPICA's
# default handler for PCI configuration space is built only with PCI, and
# without it, loading the ACPI tables fails.
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y

# kernel.config takes SCSI out, since QEMU has no SCSI disk.
CONFIG_SCSI=y
CONFIG_SCSI_LOWLEVEL=y
CONFIG_BLK_DEV_SD=y
CONFIG_HYPERV_STORAGE=y

# Hyper-V has no virtio-fs; it shares folders over Plan 9 on a vsock port.
# The file system of Plan 9 is behind NETWORK_FILESYSTEMS, which
# microvm.config leaves out.
CONFIG_HYPERV_VSOCKETS=y
# vsock takes one transport to the host. The virtio one of kernel.config
# would take it first, and hv_sock would fail to register.
# CONFIG_VIRTIO_VSOCKETS is not set
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_9P_FS=y

CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
