# The VM aibox runs Claude Code in on macOS, booted by Virtualization.framework
# without an initrd and without systemd. It is the image of the Imagefile for
# arm64, built with Apple's container tool until miso runs on macOS:
#
#   just image
#
# builds the init of the VM for arm64 into image/aibox-init, so that the
# image needs no Go toolchain, and leaves out/vmlinuz and out/os.ext4, as
# miso does on Linux. The stages follow the Imagefile, so that a change to
# one belongs in the other too. The kernel comes from kernel.Containerfile,
# as the kernels of the Imagefile come from kernel.Imagefile.

# The programs of the VM, each collected with the libraries it loads into a
# tree of its own under /out.
FROM debian:sid AS tools

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      pax-utils busybox-static bash git ca-certificates curl e2fsprogs uidmap \
      libstdc++6 libgcc-s1 zlib1g
# The installer puts Claude Code in the home directory. It goes to /usr/bin
# because the disk of a project is mounted over /usr/local.
RUN curl -fsSL https://claude.ai/install.sh | bash && \
    install -m 0755 "$(readlink -f /root/.local/bin/claude)" /usr/bin/claude
# mise installs the toolchains a project names, with the mise setting of
# the config. Its static build needs no libraries.
RUN curl -fsSLo /usr/bin/mise https://github.com/jdx/mise/releases/download/v2026.10.9/mise-v2026.10.9-linux-arm64-musl && \
    echo "0c7f27abf12f80949837fe281137b6c68a8af47cd70068559516eb6160e1728d  /usr/bin/mise" | sha256sum -c - && \
    chmod 0755 /usr/bin/mise

RUN lddtree --copy-to-tree /out/bash /usr/bin/bash
RUN lddtree --copy-to-tree /out/git /usr/bin/git /usr/lib/git-core/git-remote-http
RUN lddtree --copy-to-tree /out/claude /usr/bin/claude
# curl downloads for install scripts like rustup's, and for Claude Code
RUN lddtree --copy-to-tree /out/curl /usr/bin/curl
# the init formats the state disk of a project on its first boot
RUN lddtree --copy-to-tree /out/mke2fs /usr/sbin/mke2fs
# rootless containers map their users through these two setuid programs
RUN lddtree --copy-to-tree /out/uidmap /usr/bin/newuidmap /usr/bin/newgidmap
# the libraries prebuilt toolchains load, like Node, Python and Rust from
# mise, which the programs above don't bring: the C++ runtime, zlib and
# the parts of glibc
RUN lddtree --copy-to-tree /out/libs \
      /usr/lib/*-linux-gnu/libstdc++.so.6 /usr/lib/*-linux-gnu/libgcc_s.so.1 /usr/lib/*-linux-gnu/libz.so.1 \
      /usr/lib/*-linux-gnu/libm.so.6 /usr/lib/*-linux-gnu/libdl.so.2 /usr/lib/*-linux-gnu/libpthread.so.0 \
      /usr/lib/*-linux-gnu/librt.so.1 /usr/lib/*-linux-gnu/libutil.so.1 /usr/lib/*-linux-gnu/libresolv.so.2

FROM scratch AS root

# busybox gives the stage a shell, so the RUN steps below work, and the VM
# its basic tools. The tool leaves the sh link of the Imagefile out of the
# context, since it points at nothing there, so busybox makes it, in the
# exec form that needs no shell yet.
COPY --from=tools /bin/busybox /bin/busybox
RUN ["/bin/busybox", "--install", "-s", "/bin"]
# /usr/local and /var/lib/aibox/state are mount points for the state disk
RUN mkdir -p /run /tmp /root /project /home/user /usr/local /var/lib/aibox/state

COPY --from=tools /out/bash/ /
COPY --from=tools /out/git/ /
COPY --from=tools /usr/lib/git-core/ /usr/lib/git-core/
COPY --from=tools /usr/share/git-core/ /usr/share/git-core/
COPY --from=tools /out/claude/ /
COPY --from=tools /out/curl/ /
COPY --from=tools /usr/bin/mise /usr/bin/mise
COPY mise.toml /etc/mise/config.toml
COPY --from=tools /out/mke2fs/ /
COPY --from=tools /etc/mke2fs.conf /etc/
# lddtree drops the setuid bit, which the two need to map the subuid
# range of "user", the user of the passwd file
COPY --from=tools /out/uidmap/ /
COPY --from=tools /out/libs/ /
RUN chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap
COPY --from=tools /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY passwd group subuid subgid /etc/
COPY hosts nsswitch.conf /etc/
COPY gitconfig /etc/gitconfig
# podman's defaults: a container shares the network of the VM, and images
# are not checked for signatures, since the allow list of the proxy already
# says where they may come from
COPY containers/ /etc/containers/
COPY aibox.md /etc/aibox/prompt.md
COPY task.md /etc/aibox/task.md
# the part of the host each prompt ends with, which on arm64 is always a Mac
COPY host/macos.md /etc/aibox/host.md
COPY aibox-init /sbin/init
# the init answers as xclip and wl-paste, the clipboard tools Claude Code
# runs for Ctrl+V, with the clipboard of the host
RUN ln -s /sbin/init /usr/bin/xclip && ln -s /sbin/init /usr/bin/wl-paste
# busybox put env into /bin, and scripts look for it in /usr/bin
RUN ln -s /bin/env /usr/bin/env

# miso writes the root disk itself, here mke2fs does, from the tree of the
# root stage. The disk gets a fifth more than its files take, for the file
# system itself.
FROM debian:sid AS disk

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends e2fsprogs
COPY --from=root / /root-tree/
# the copy keeps the setuid bits rootless containers need, and a tool that
# dropped them would break podman in the VM without a word
RUN test -u /root-tree/usr/bin/newuidmap && test -u /root-tree/usr/bin/newgidmap
RUN mkdir -p /root-tree/proc /root-tree/sys /root-tree/dev && \
    size=$(( $(du -sm /root-tree | cut -f1) * 6 / 5 + 32 )) && \
    mke2fs -q -t ext4 -L aiboxroot -d /root-tree /os.ext4 "${size}M"

FROM scratch AS out

COPY --from=disk /os.ext4 /os.ext4
