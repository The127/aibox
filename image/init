#!/bin/busybox sh
# The first process of the VM until aibox has an init of its own. It mounts
# what the programs need, the folders shared from the host if there are any,
# and opens a shell on the console. The VM powers off when the shell ends.

# miso leaves /proc, /sys and /dev out of a rootfs built from scratch.
mkdir -p /proc /sys /dev
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
mount -t virtiofs project /project 2>/dev/null
mount -t virtiofs home /root 2>/dev/null

export HOME=/root PATH=/usr/local/bin:/usr/bin:/bin
cd /project

setsid cttyhack /usr/bin/bash -l
poweroff -f
