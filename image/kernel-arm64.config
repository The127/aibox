# Merged on top of vz-arm64.config, as kernel.config is on top of
# microvm.config for x86, with what aibox changes about it.

# What the VM is made of on Virtualization.framework: virtio devices on PCI,
# a disk with ext4, folders shared over virtio-fs, vsock to the host, a
# virtio console and the entropy device.
CONFIG_PCI_HOST_GENERIC=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_UNIX98_PTYS=y

# KVM, so that a VM inside the VM runs with hardware support where the Mac
# offers nested virtualization. The namespaces, cgroups and overlayfs that
# containers need are already on.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y

# There is no network card. The network stack serves the loopback interface
# and nothing else.
# CONFIG_NETDEVICES is not set
# CONFIG_VIRTIO_NET is not set
# CONFIG_TUN is not set
# CONFIG_BRIDGE is not set
# CONFIG_NETFILTER is not set
# CONFIG_NET_SCHED is not set
# CONFIG_IPV6 is not set
# CONFIG_INET_ESP is not set
# CONFIG_XFRM is not set
# CONFIG_XFRM_USER is not set
# CONFIG_XFRM_STATISTICS is not set
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_MULTICAST is not set
# CONFIG_IP_PNP is not set
# CONFIG_NET_IPIP is not set
# CONFIG_NET_IPGRE_DEMUX is not set
# CONFIG_IP_MROUTE is not set
# CONFIG_NET_UDP_TUNNEL is not set
# CONFIG_INET_TUNNEL is not set
# CONFIG_INET_DIAG is not set
# CONFIG_TCP_CONG_ADVANCED is not set
# CONFIG_TCP_MD5SIG is not set
# CONFIG_MPTCP is not set
# CONFIG_SYN_COOKIES is not set
# CONFIG_NETWORK_PHY_TIMESTAMPING is not set
# CONFIG_NETLINK_DIAG is not set
# CONFIG_UNIX_DIAG is not set
# CONFIG_PACKET is not set
# CONFIG_CGROUP_NET_PRIO is not set
# CONFIG_CGROUP_NET_CLASSID is not set
# CONFIG_ETHTOOL_NETLINK is not set

# The only disk is the virtio one, and there is no other block or memory
# device.
# CONFIG_SCSI is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_BLK_DEV_PMEM is not set
# CONFIG_VIRTIO_PMEM is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_MEM is not set

# Memory and CPUs are fixed when the VM starts, the CPUs are virtual, and
# the VM never boots another kernel.
# CONFIG_MEMORY_HOTPLUG is not set
# CONFIG_NUMA is not set
# CONFIG_KEXEC_CORE is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_IOMMU_SUPPORT is not set

# File systems and memory features the VM never uses.
# CONFIG_SWAP is not set
# CONFIG_KSM is not set
# CONFIG_QUOTA is not set
# CONFIG_AUTOFS_FS is not set
# CONFIG_HUGETLBFS is not set
# CONFIG_EROFS_FS is not set
# CONFIG_FS_ENCRYPTION is not set

# Debugging and diagnostics.
# CONFIG_PSTORE is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_PROFILING is not set
# CONFIG_CGROUP_PERF is not set
# CONFIG_CRYPTO_SELFTESTS is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_SECTION_MISMATCH is not set
