# The VM aibox runs Claude Code in, booted on QEMU's microvm machine, or on
# Hyper-V, without an initrd and without systemd.
#
#   just image
#
# builds the init of the VM into image/aibox-init, so that the image needs no
# Go toolchain, and leaves out/vmlinuz, out/vmlinuz-hyperv and out/os.ext4.

# Each kernel of the image starts from this stage, so that the source is
# unpacked once.
FROM debian:sid AS source

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential bc bison flex libelf-dev libssl-dev cpio xz-utils linux-source-7.2
RUN mkdir /src && tar -xf /usr/src/linux-source-7.2.tar.xz -C /src && mv /src/linux-source-7.2 /src/linux
COPY check-kernel-config /src/

FROM source AS kernel

# microvm.config is a complete kernel configuration for QEMU's microvm
# board, generated for the 7.2 kernels above and taken over as it is.
# kernel.config holds only what aibox changes about it, so that a newer
# microvm.config can be dropped in.
COPY microvm.config kernel.config /src/
RUN cd /src/linux && \
    scripts/kconfig/merge_config.sh -m /src/microvm.config /src/kernel.config && make olddefconfig
RUN sh /src/check-kernel-config /src/linux/.config /src/kernel.config
RUN cd /src/linux && make -j"$(nproc)" bzImage

OUTPUT kernel vmlinuz --path=/src/linux/arch/x86/boot/bzImage

# Hyper-V boots the same root disk with a kernel of its own, since it has
# none of the virtio devices the kernel above drives.
FROM source AS kernel-hyperv

COPY microvm.config kernel.config kernel-hyperv.config /src/
RUN cd /src/linux && \
    scripts/kconfig/merge_config.sh -m /src/microvm.config /src/kernel.config /src/kernel-hyperv.config && make olddefconfig
RUN sh /src/check-kernel-config /src/linux/.config /src/kernel.config /src/kernel-hyperv.config
RUN cd /src/linux && make -j"$(nproc)" bzImage

OUTPUT kernel vmlinuz-hyperv --path=/src/linux/arch/x86/boot/bzImage

# The programs of the VM, each collected with the libraries it loads into a
# tree of its own under /out.
FROM debian:sid AS tools

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      pax-utils busybox-static bash git ca-certificates curl e2fsprogs uidmap
# The installer puts Claude Code in the home directory. It goes to /usr/bin
# because the disk of a project is mounted over /usr/local.
RUN curl -fsSL https://claude.ai/install.sh | bash && \
    install -m 0755 "$(readlink -f /root/.local/bin/claude)" /usr/bin/claude

RUN lddtree --copy-to-tree /out/bash /usr/bin/bash
RUN lddtree --copy-to-tree /out/git /usr/bin/git /usr/lib/git-core/git-remote-http
RUN lddtree --copy-to-tree /out/claude /usr/bin/claude
# the init formats the state disk of a project on its first boot
RUN lddtree --copy-to-tree /out/mke2fs /usr/sbin/mke2fs
# rootless containers map their users through these two setuid programs
RUN lddtree --copy-to-tree /out/uidmap /usr/bin/newuidmap /usr/bin/newgidmap

FROM scratch

# busybox gives the stage a shell, so the RUN steps below work, and the VM
# its basic tools.
COPY --from=tools /bin/busybox /bin/busybox
COPY sh /bin/sh
RUN /bin/busybox --install -s /bin
# /usr/local and /var/lib/aibox/state are mount points for the state disk
RUN mkdir -p /run /tmp /root /project /home/user /usr/local /var/lib/aibox/state

COPY --from=tools /out/bash/ /
COPY --from=tools /out/git/ /
COPY --from=tools /usr/lib/git-core/ /usr/lib/git-core/
COPY --from=tools /usr/share/git-core/ /usr/share/git-core/
COPY --from=tools /out/claude/ /
COPY --from=tools /out/mke2fs/ /
COPY --from=tools /etc/mke2fs.conf /etc/
# lddtree drops the setuid bit, which the two need to map the subuid
# range of "user", the user of the passwd file
COPY --from=tools /out/uidmap/ /
RUN chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap
COPY --from=tools /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY passwd group subuid subgid /etc/
COPY hosts nsswitch.conf /etc/
COPY gitconfig /etc/gitconfig
# podman's defaults: a container shares the network of the VM, and images
# are not checked for signatures, since the allow list of the proxy already
# says where they may come from
COPY containers/ /etc/containers/
COPY aibox.md /etc/aibox/prompt.md
COPY task.md /etc/aibox/task.md
COPY aibox-init /sbin/init

OUTPUT rootfs os.ext4
