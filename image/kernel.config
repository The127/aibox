# Merged into x86_64_defconfig. Everything the VM needs is built in, so the
# kernel mounts its root disk without an initrd.
# CONFIG_MODULES is not set
# QEMU runs the microvm board with acpi=off and announces the devices on the
# kernel command line, so the kernel needs neither a PCI bus nor ACPI
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_EXT4_FS=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
